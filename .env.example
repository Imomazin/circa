# Circa — environment variable template.
# Copy to .env.local and fill with your own credentials.
# NEVER commit real values. All secrets are provided via environment variables only.

# Neon PostgreSQL connection string (pooled connection recommended for serverless).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional: direct (non-pooled) connection, used by some migration tooling.
DATABASE_URL_UNPOOLED=

# Public base URL of the deployment (optional; used for absolute links).
NEXT_PUBLIC_APP_URL=
